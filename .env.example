# Datto RMM API (from Setup > Users > Generate API Keys)
DATTO_API_BASE_URL=https://zinfandel-api.centrastage.net
DATTO_API_KEY=
DATTO_API_SECRET=

# Quick job component (from GET /v2/account/components or UI)
DATTO_COMPONENT_UID=
DATTO_JOB_NAME=Webhook remediation
DATTO_JOB_VARIABLES_JSON=[]

# Inbound webhook authentication
WEBHOOK_SECRET=

# Scheduler
QUICKJOB_INTERVAL_MINUTES=15
RUN_ON_DETECT=true

# Persistence
DATA_DIR=/data
PORT=8080
