# Datto RMM API (from Setup > Users > Generate API Keys)
DATTO_API_BASE_URL=https://zinfandel-api.centrastage.net
DATTO_API_KEY=
DATTO_API_SECRET=

# Webhook profiles (copy config/profiles.example.yaml to config/profiles.yaml)
PROFILES_CONFIG_PATH=/config/profiles.yaml

# Legacy single-profile fallback (only if profiles file is missing)
# WEBHOOK_SECRET=
# DATTO_COMPONENT_UID=
# DATTO_JOB_NAME=Webhook remediation
# DATTO_JOB_VARIABLES_JSON=[]

# Scheduler
QUICKJOB_INTERVAL_MINUTES=15
RUN_ON_DETECT=true

# Persistence
DATA_DIR=/data
PORT=8080
